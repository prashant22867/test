# Copy to .env and fill in your Alpaca API keys (generate from the Alpaca dashboard).
# Start with PAPER keys and the paper base URL below.

APCA_API_KEY_ID=your_key_id_here
APCA_API_SECRET_KEY=your_secret_key_here

# Paper trading (default). For live trading use: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: port for the local server (default 3000)
PORT=3000

# Optional: set to true to serve baked-in sample data with no API keys / network.
# DEMO=true
